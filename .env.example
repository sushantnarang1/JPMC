LLM_PROVIDER=lmstudio
LM_STUDIO_BASE_URL=http://host.docker.internal:1234/v1
LLM_REQUEST_TIMEOUT=120
LLM_MAX_OUTPUT_TOKENS=512
MODEL_OPS_CORS_ORIGINS=http://localhost:5174,http://127.0.0.1:5174
# Optional; LM Studio commonly does not require an API key.
# LM_STUDIO_API_KEY=
# Production deployment model versions are denied unless explicitly approved.
# MODEL_OPS_PRODUCTION_APPROVED_MODELS=qwen/qwen3.6-35b-a3b
# GPU-enabled environments:
# MODEL_OPS_GPU_ALLOWED_ENVIRONMENTS=staging,production

# Direct-host backend runs can override the Docker Desktop hostname:
# LM_STUDIO_BASE_URL=http://localhost:1234/v1
